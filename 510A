#include <iostream>

using namespace std;

int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, m;
    cin >> n >> m;

    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= m; j++) {
            if (i % 2 != 0) {
                // Odd rows are completely filled with '#'
                cout << "#";
            } else {
                // Even rows alternate between having a '#' on the right or left edge
                if (i % 4 == 2) {
                    // Snake moves down on the right side
                    if (j == m) cout << "#";
                    else cout << ".";
                } else if (i % 4 == 0) {
                    // Snake moves down on the left side
                    if (j == 1) cout << "#";
                    else cout << ".";
                }
            }
        }
        cout << "\n"; // Move to the next row
    }

    return 0;
}
