#include <iostream>
using namespace std;

int main()
{
  int k,n,w;
  cin >> k >> n >> w;
  long long cost=0;
  
  for(int i=1;i<=w;i++)
  {
    cost = cost + i*k;
  }
  if(cost == n)
  {
    cout << 0;
  }
  else if(cost > n)
  {
    cout << cost-n;
  }
  else
  {
    cout << 0;
  }
  
  return 0;
}
