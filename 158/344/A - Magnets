#include <iostream>
using namespace std;
#include <vector>

int main()
{
  int n;int c=1;
  cin >> n;
  vector<int> nums(n);
  for(int i=0;i<n;i++)  
  {
     cin >> nums[i];         
  }
  for(int i=0;i<n-1;i++)
  {
     if(nums[i] != nums[i+1])
     {
        c++;
     }
  }
  cout << c;
  return 0;
}
